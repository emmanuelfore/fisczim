 // --- 5. LEAVE REQUESTS & ACCRUALS ENDPOINTS ---
+router.get("/leave/balances", async (req, res) => {
+  try {
+    const companyId = getTargetCompanyId(req);
+    // Join leaveBalances with employees to enforce company isolation
+    const results = await db.select({
+      id: leaveBalances.id,
+      employeeId: leaveBalances.employeeId,
+      leaveType: leaveBalances.leaveType,
+      accruedDays: leaveBalances.accruedDays,
+      usedDays: leaveBalances.usedDays,
+      availableDays: leaveBalances.availableDays,
+      employee: employees
+    })
+      .from(leaveBalances)
+      .innerJoin(employees, eq(leaveBalances.employeeId, employees.id))
+      .where(eq(employees.companyId, companyId))
+      .orderBy(asc(employees.lastName));
+    res.json(results);
+  } catch (err: any) {
+    res.status(500).json({ error: "INTERNAL_ERROR", message: err.message });
+  }
+});
+
+router.post("/leave/accrue", requirePayrollWrite, async (req, res) => {
+  // Enforces Labour Act: 2.5 days/month (30/yr), max 90 days.
+  const schema = z.object({ month: z.string() });
+  const parsed = schema.safeParse(req.body);
+  if (!parsed.success) return res.status(400).json({ error: "VALIDATION_ERROR", details: parsed.error.errors });
+
+  try {
+    const companyId = getTargetCompanyId(req);
+    const activeEmployees = await db.select({ id: employees.id })
+      .from(employees)
+      .where(and(eq(employees.companyId, companyId), eq(employees.status, "ACTIVE")));
+
+    let processedCount = 0;
+    for (const emp of activeEmployees) {
+      const [balance] = await db.select().from(leaveBalances)
+        .where(and(eq(leaveBalances.employeeId, emp.id), eq(leaveBalances.leaveType, "ANNUAL")))
+        .limit(1);
+
+      if (!balance) {
+        // Initial accrual
+        await db.insert(leaveBalances).values({
+          employeeId: emp.id, leaveType: "ANNUAL", accruedDays: "2.50", usedDays: "0.00", availableDays: "2.50"
+        });
+        processedCount++;
+      } else {
+        // Max 90 days statutory cap
+        let currentAvail = parseFloat(balance.availableDays);
+        if (currentAvail < 90) {
+          let nextAvail = Math.min(90, currentAvail + 2.5);
+          let newAccrued = parseFloat(balance.accruedDays) + (nextAvail - currentAvail);
+          await db.update(leaveBalances).set({
+            accruedDays: newAccrued.toFixed(2),
+            availableDays: nextAvail.toFixed(2)
+          }).where(eq(leaveBalances.id, balance.id));
+          processedCount++;
+        }
+      }
+    }
+    
+    res.json({ processedCount, month: parsed.data.month });
+  } catch (err: any) {
+    res.status(500).json({ error: "INTERNAL_ERROR", message: err.message });
+  }
+});
+
