# Supabase Configuration (NEW PROJECT: nopztclveukecdabuist)
SUPABASE_URL=https://nopztclveukecdabuist.supabase.co
SUPABASE_ANON_KEY=your-new-anon-key-here
SUPABASE_SERVICE_KEY=your-new-service-key-here

# Frontend Environment Variables
VITE_SUPABASE_URL=https://nopztclveukecdabuist.supabase.co
VITE_SUPABASE_ANON_KEY=your-new-anon-key-here

# Database URL for Drizzle ORM (with connection pooling)
SUPABASE_DB_URL=postgresql://postgres.nopztclveukecdabuist:your-db-password@aws-1-eu-west-3.pooler.supabase.com:5432/postgres

# JWT secret for local token verification (Dashboard > Settings > API > JWT Secret)
# Verify access tokens locally in the API middleware to avoid per-request auth egress.
SUPABASE_JWT_SECRET=your-new-jwt-secret-here

# Application
NODE_ENV=development
PORT=5000
VITE_API_URL=https://fiscalstack.co.zw

# Logging Configuration
API_RESPONSE_LOGS=1
POS_VERBOSE_LOGS=1

# Sage Business Cloud Integration
SAGE_WEBHOOK_SIGNING_KEY=your-sage-webhook-signing-key
SAGE_API_BASE_URL=https://api.accounting.sage.com
SAGE_CLIENT_ID=your-sage-client-id
SAGE_CLIENT_SECRET=your-sage-client-secret

# Mobile App Update Checker
# Bump MOBILE_LATEST_VERSION + set MOBILE_APK_URL on every new release
MOBILE_LATEST_VERSION=0.1.0
MOBILE_APK_URL=https://your-host.com/fieldpos-latest.apk
MOBILE_RELEASE_NOTES=
