<Window x:Class="FiscalStackPOS.Dialogs.PrintPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource pv.title}" Width="460" Height="700" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI" ShowInTaskbar="False">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock x:Name="LblTitle" Style="{StaticResource H2Text}" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="{DynamicResource pv.print}" Style="{StaticResource PrimaryButton}" MinWidth="110" Click="OnPrint" IsDefault="True" />
                <Button Content="{DynamicResource common.cancel}" Style="{StaticResource GhostButton}" MinWidth="80" Margin="10,0,0,0"
                        IsCancel="True" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Image x:Name="PreviewImg" Stretch="None" />
        </ScrollViewer>
    </DockPanel>
</Window>