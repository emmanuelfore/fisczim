<UserControl x:Class="FiscalStackPOS.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource rep.title}" Style="{StaticResource H1Text}" Grid.Row="0" />

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <StackPanel Margin="4">
                    <TextBlock Text="{DynamicResource rep.fiscalDay}" Style="{StaticResource H3Text}" />
                    <TextBlock x:Name="LblDayNo" Style="{StaticResource BodyText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="LblStatus" Style="{StaticResource BodyText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <Button Content="{DynamicResource rep.openDay}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="OnOpenDay" />
                    <Button Content="{DynamicResource rep.closeDay}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnCloseDay" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel Margin="4">
                    <TextBlock Text="{DynamicResource rep.reports}" Style="{StaticResource H3Text}" />
                    <Button Content="{DynamicResource rep.x}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="OnX" />
                    <Button Content="{DynamicResource rep.z}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnZ" />
                    <Button Content="{DynamicResource rep.submit}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnSubmit" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="LblResult" Grid.Row="2" Style="{StaticResource BodyText}" Margin="0,14,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>