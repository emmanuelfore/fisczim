+router.get("/exports/bank", async (req, res) => {
+  const companyId = getTargetCompanyId(req);
+  const runId = req.query.runId ? Number(req.query.runId) : null;
+  const format = req.query.format ? String(req.query.format) : "csv"; // csv, ecocash
+  
+  if (!runId) return res.status(400).json({ error: "Missing runId parameter" });
+  
+  try {
+    const run = await db.query.payrollRuns.findFirst({
+      where: and(eq(payrollRuns.id, runId), eq(payrollRuns.companyId, companyId))
+    });
+    
+    if (!run) return res.status(404).json({ error: "Run not found" });
+
+    const lines = await db.select({
+      netSalary: payrollRunEmployees.netSalary,
+      firstName: employees.firstName,
+      lastName: employees.lastName,
+      bankName: employees.bankName,
+      bankBranch: employees.bankBranch,
+      bankAccountNumber: employees.bankAccountNumber,
+      ecocashNumber: employees.ecocashNumber,
+    })
+    .from(payrollRunEmployees)
+    .innerJoin(employees, eq(payrollRunEmployees.employeeId, employees.id))
+    .where(eq(payrollRunEmployees.payrollRunId, runId));
+
+    if (format === 'csv') {
+      let csv = "Employee Name,Bank Name,Branch Code,Account Number,Net Pay\n";
+      for (const line of lines) {
+        if (!line.bankAccountNumber) continue; // Skip if no bank account
+        csv += `${line.firstName} ${line.lastName},${line.bankName || ''},${line.bankBranch || ''},${line.bankAccountNumber},${parseFloat(line.netSalary).toFixed(2)}\n`;
+      }
+      res.setHeader('Content-Type', 'text/csv');
+      res.setHeader('Content-Disposition', `attachment; filename=Bank_Remittance_${runId}.csv`);
+      return res.send(csv);
+    } else if (format === 'ecocash') {
+      let csv = "Mobile Number,Amount,Reference\n";
+      for (const line of lines) {
+        if (!line.ecocashNumber) continue; // Skip if no ecocash
+        csv += `${line.ecocashNumber},${parseFloat(line.netSalary).toFixed(2)},Salary\n`;
+      }
+      res.setHeader('Content-Type', 'text/csv');
+      res.setHeader('Content-Disposition', `attachment; filename=Ecocash_Remittance_${runId}.csv`);
+      return res.send(csv);
+    } else {
+      res.status(400).json({ error: "Unsupported format" });
+    }
+
+  } catch (err: any) {
+    res.status(500).json({ error: "INTERNAL_ERROR", message: err.message });
+  }
+});
