<Window x:Class="FiscalStackPOS.Dialogs.FirstRunDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource fr.title}"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI"
        ShowInTaskbar="False">
    <Border Style="{StaticResource Card}" Margin="24">
        <StackPanel>
            <TextBlock Text="{DynamicResource fr.title}" Style="{StaticResource H1Text}" />
            <TextBlock Text="{DynamicResource fr.desc}"
                       Style="{StaticResource BodyText}" Margin="0,6,0,18" TextWrapping="Wrap" />

            <TextBlock Text="{DynamicResource fr.username}" Style="{StaticResource CaptionText}" Margin="0,8,0,4" />
            <TextBox x:Name="TxtUsername" Style="{StaticResource FieldTextBox}" />
            <TextBlock Text="{DynamicResource fr.fullName}" Style="{StaticResource CaptionText}" Margin="0,12,0,4" />
            <TextBox x:Name="TxtFullName" Style="{StaticResource FieldTextBox}" />
            <TextBlock Text="{DynamicResource fr.password}" Style="{StaticResource CaptionText}" Margin="0,12,0,4" />
            <PasswordBox x:Name="TxtPassword" Style="{StaticResource FieldPasswordBox}" />
            <TextBlock Text="{DynamicResource fr.confirm}" Style="{StaticResource CaptionText}" Margin="0,12,0,4" />
            <PasswordBox x:Name="TxtConfirm" Style="{StaticResource FieldPasswordBox}" />
            <TextBlock x:Name="LblError" Foreground="{StaticResource DangerBrush}" FontSize="12"
                       Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="{DynamicResource common.cancel}" Style="{StaticResource GhostButton}" IsCancel="True" MinWidth="88" />
                <Button Content="{DynamicResource fr.create}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" MinWidth="104"
                        Click="OnCreate" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>