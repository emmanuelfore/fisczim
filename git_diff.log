+  async checkPeriodStatus(companyId: number, targetDate: Date, subLedger: "AR" | "AP" | "INVENTORY" | "BANK" | "GL", tx: any = db): Promise<void> {
+    const periods = await tx.select().from(financialPeriods).where(eq(financialPeriods.companyId, companyId));
+    const applicablePeriod = periods.find((p: any) => {
+      const pStart = new Date(p.startDate);
+      const pEnd = new Date(p.endDate);
+      return targetDate >= pStart && targetDate <= pEnd;
+    });
+
+    if (!applicablePeriod) return;
+
+    if (applicablePeriod.status === "CLOSED" || applicablePeriod.status === "LOCKED") {
+       throw new Error(`The financial period '${applicablePeriod.name}' is globally closed.`);
+    }
+
+    if (subLedger === "AR" && applicablePeriod.arClosed) {
+       throw new Error(`Accounts Receivable is closed for the financial period '${applicablePeriod.name}'.`);
+    }
+    if (subLedger === "AP" && applicablePeriod.apClosed) {
+       throw new Error(`Accounts Payable is closed for the financial period '${applicablePeriod.name}'.`);
+    }
+    if (subLedger === "INVENTORY" && applicablePeriod.inventoryClosed) {
+       throw new Error(`Inventory is closed for the financial period '${applicablePeriod.name}'.`);
+    }
+    if (subLedger === "BANK" && applicablePeriod.bankClosed) {
+       throw new Error(`Bank/Cash transactions are closed for the financial period '${applicablePeriod.name}'.`);
+    }
+  }
