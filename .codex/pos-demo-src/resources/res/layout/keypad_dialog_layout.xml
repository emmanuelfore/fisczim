<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/keypaddialog"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/pk_up_lay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="30dp">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/ivLogo"
                android:background="@drawable/logo_aqsi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/pk_title_sum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="К оплате : 50.00 "/>
            <TextView
                android:textSize="22sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/pk_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Введите ПИН-код"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/pk_ptc_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text=""/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:paddingTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent">\10s\10
                <EditText
                    android:enabled="false"
                    android:textSize="28sp"
                    android:textColor="@color/color_777572"
                    android:gravity="center"
                    android:id="@+id/pwdEdtiInput"
                    android:background="@color/white"
                    android:paddingRight="25dp"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:inputType="textMultiLine"/>
                <ImageView
                    android:gravity="center_vertical"
                    android:id="@+id/pk_ivDel"
                    android:background="@drawable/del_draw"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginRight="20dp"
                    android:layout_alignRight="@+id/pwdEdtiInput"/>
                <ImageView
                    android:id="@+id/ivClose"
                    android:background="@drawable/close_draw"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginRight="-5dp"
                    android:layout_alignParentRight="true"/>
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/replaceLL"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
