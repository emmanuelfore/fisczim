<Window x:Class="FiscalStackPOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FiscalStack POS"
        Icon="/FiscalStackPOS;component/fiscalstack.png"
        Width="1380" Height="840" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource NavRailWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ left navigation rail (Aronium style) ============ -->
        <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- brand mark -->
                <StackPanel DockPanel.Dock="Top" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="/FiscalStackPOS;component/fiscalstack.png"
                           Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality" />
                </StackPanel>

                <UniformGrid Columns="1" DockPanel.Dock="Top" Margin="0,6,0,0">
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" IsChecked="True"
                                 ToolTip="{DynamicResource nav.pos}" Tag="pos" Checked="OnNav">
                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="19" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 ToolTip="{DynamicResource nav.products}" Tag="products" Checked="OnNav">
                        <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="19" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 ToolTip="{DynamicResource nav.history}" Tag="history" Checked="OnNav">
                        <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="19" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 ToolTip="{DynamicResource nav.reports}" Tag="reports" Checked="OnNav">
                        <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="19" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 ToolTip="{DynamicResource nav.users}" Tag="users" Checked="OnNav">
                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="19" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 ToolTip="{DynamicResource nav.settings}" Tag="settings" Checked="OnNav">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="19" />
                    </RadioButton>
                </UniformGrid>

                <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,10">
                    <Button Style="{StaticResource NavIconButton}" Tag="quit" Click="OnQuit" ToolTip="{DynamicResource common.exit}">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                   Foreground="{StaticResource DangerBrush}" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ main area ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- header bar -->
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="LblCompany" Style="{StaticResource H2Text}" VerticalAlignment="Center" Text="{DynamicResource hdr.company}" />
                        <TextBlock x:Name="LblDay" Style="{StaticResource BodyText}" VerticalAlignment="Center"
                                   Margin="14,2,0,0" Text="{DynamicResource hdr.day}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- till -->
                        <Border x:Name="ChipTill" CornerRadius="8" Background="{StaticResource BorderLightBrush}"
                                Padding="10,5" Margin="0,0,8,0">
                            <TextBlock x:Name="LblTill" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" Text="till closed" />
                        </Border>
                        <!-- queue -->
                        <Border x:Name="ChipQueue" CornerRadius="8" Background="{StaticResource WarnBgBrush}"
                                Padding="10,5" Margin="0,0,8,0">
                            <TextBlock x:Name="LblQueue" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource WarnBrush}" Text="queue 0" />
                        </Border>
                        <!-- online -->
                        <Border x:Name="ChipOnline" CornerRadius="8" Background="{StaticResource SuccessBgBrush}"
                                Padding="10,5" Margin="0,0,14,0">
                            <TextBlock x:Name="LblOnline" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource SuccessBrush}" Text="online" />
                        </Border>

                        <!-- user -->
                        <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource PrimaryAlphaBrush}"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="LblAvatar" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" Text="?" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="LblUser" Style="{StaticResource H2Text}" FontSize="13" Text="operator" />
                            <TextBlock x:Name="LblClock" Style="{StaticResource CaptionText}" Text="--:--" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- content -->
            <ContentControl x:Name="Host" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>