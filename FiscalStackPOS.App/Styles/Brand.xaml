<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ brand palette (web-POS / your colors) ============ -->
    <Color x:Key="BrandPrimary">#6366F1</Color>
    <Color x:Key="BrandPrimaryDark">#4F46E5</Color>
    <Color x:Key="BrandSky">#0EA5E9</Color>
    <Color x:Key="BrandPrimaryAlpha">#EEF2FF</Color>
    <Color x:Key="BrandSkyAlpha">#F0F9FF</Color>

    <SolidColorBrush x:Key="BgBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#6366F1" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#4F46E5" />
    <SolidColorBrush x:Key="SkyBrush" Color="#0EA5E9" />
    <SolidColorBrush x:Key="PrimaryAlphaBrush" Color="#EEF2FF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#ECFDF5" />
    <SolidColorBrush x:Key="WarnBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="WarnBgBrush" Color="#FFFBEB" />
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="DangerBgBrush" Color="#FEF2F2" />
    <SolidColorBrush x:Key="TextBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B" />
    <SolidColorBrush x:Key="TextSecondaryLightBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0"/>
        <GradientStop Color="#4F46E5" Offset="0.55"/>
        <GradientStop Color="#0EA5E9" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryGradientSoftBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EEF2FF" Offset="0"/>
        <GradientStop Color="#E0F2FE" Offset="1"/>
    </LinearGradientBrush>

    <!-- Shadows (kept light: heavy blur effects stall restore-from-minimized on low-end GPUs) -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.08" Color="#0F172A" />
    <DropShadowEffect x:Key="CardShadowHover" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.12" Color="#0F172A" />
    <DropShadowEffect x:Key="ModalShadow" BlurRadius="12" ShadowDepth="4" Direction="270" Opacity="0.25" Color="#0F172A" />

    <!-- ============ layout constants ============ -->
    <GridLength x:Key="NavRailWidth">64</GridLength>
    <GridLength x:Key="CartPanelWidth">348</GridLength>

    <ItemsPanelTemplate x:Key="TilePanel"><WrapPanel /></ItemsPanelTemplate>
</ResourceDictionary>