<UserControl x:Class="FiscalStackPOS.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource prod.title}" Style="{StaticResource H1Text}" VerticalAlignment="Center" />
            <TextBox x:Name="TxtSearch" Grid.Column="1" Width="320" HorizontalAlignment="Center"
                     Style="{StaticResource FieldTextBox}" TextChanged="OnSearch" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="{DynamicResource prod.new}" Click="OnNew" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                <Button Content="{DynamicResource prod.edit}" Click="OnEdit" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                <Button Content="{DynamicResource prod.delete}" Click="OnDelete" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                <Button Content="{DynamicResource prod.import}" Click="OnImport" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                <Button Content="{DynamicResource prod.export}" Click="OnExport" Style="{StaticResource SecondaryButton}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
            <DataGrid x:Name="Grid" Style="{StaticResource ModernGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="ColName" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn x:Name="ColCode" Binding="{Binding Code}" Width="110" />
                    <DataGridTextColumn x:Name="ColBarcode" Binding="{Binding Barcode}" Width="130" />
                    <DataGridTextColumn x:Name="ColCategory" Binding="{Binding Category}" Width="110" />
                    <DataGridTextColumn x:Name="ColPrice" Binding="{Binding PriceLabel}" Width="100" />
                    <DataGridTextColumn x:Name="ColVat" Binding="{Binding VatLabel}" Width="70" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>