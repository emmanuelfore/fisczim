<UserControl x:Class="FiscalStackPOS.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource usr.title}" Style="{StaticResource H1Text}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="{DynamicResource usr.new}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OnNew" />
                <Button Content="{DynamicResource usr.reset}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OnReset" />
                <Button Content="{DynamicResource usr.toggle}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OnToggle" />
                <Button Content="{DynamicResource common.delete}" Style="{StaticResource SecondaryButton}" Click="OnDelete" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
            <DataGrid x:Name="Grid" Style="{StaticResource ModernGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="ColUser" Binding="{Binding Username}" Width="*" />
                    <DataGridTextColumn x:Name="ColFull" Binding="{Binding FullName}" Width="*" />
                    <DataGridTextColumn x:Name="ColAccess" Binding="{Binding Access}" Width="110" />
                    <DataGridTextColumn x:Name="ColEnabled" Binding="{Binding EnabledText}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>