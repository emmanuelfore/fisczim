<UserControl x:Class="FiscalStackPOS.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- title + actions -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource hist.title}" Style="{StaticResource H1Text}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="{DynamicResource hist.reprint}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OnReprint" />
                <Button Content="{DynamicResource hist.refund}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OnRefund" />
                <Button Content="{DynamicResource hist.submit}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OnSubmit" />
                <Button Content="{DynamicResource common.refresh}" Style="{StaticResource SecondaryButton}" Click="OnRefresh" />
            </StackPanel>
        </Grid>

        <!-- filter bar -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource hist.from}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <DatePicker x:Name="DpFrom" VerticalAlignment="Center" Margin="0,0,14,0" SelectedDateChanged="OnFilterChanged" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource hist.to}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <DatePicker x:Name="DpTo" VerticalAlignment="Center" Margin="0,0,14,0" SelectedDateChanged="OnFilterChanged" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource hist.cashier}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="CmbCashier" Style="{StaticResource FieldComboBox}" Width="130" MinWidth="120" Margin="0,0,14,0" SelectionChanged="OnFilterChanged" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource hist.payment}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="CmbPayment" Style="{StaticResource FieldComboBox}" Width="130" MinWidth="110" Margin="0,0,14,0" SelectionChanged="OnFilterChanged" />
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource hist.rate}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="CmbRate" Style="{StaticResource FieldComboBox}" Width="110" Margin="0,0,14,0" SelectionChanged="OnFilterChanged" />
                </StackPanel>
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource hist.flag}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="CmbFlag" Style="{StaticResource FieldComboBox}" Width="120" Margin="0,0,14,0" SelectionChanged="OnFilterChanged" />
                </StackPanel>
                <Button Grid.Column="6" Content="{DynamicResource hist.reset}" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="OnReset" />
            </Grid>
        </Border>

        <!-- receipts grid -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
            <DataGrid x:Name="Grid" Style="{StaticResource ModernGrid}" MouseDoubleClick="OnReprint">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="ColTime" Binding="{Binding Time}" Width="150" />
                    <DataGridTextColumn x:Name="ColInvoice" Binding="{Binding Invoice}" Width="110" />
                    <DataGridTextColumn x:Name="ColCashier" Binding="{Binding Cashier}" Width="110" />
                    <DataGridTextColumn x:Name="ColType" Binding="{Binding Type}" Width="100" />
                    <DataGridTextColumn x:Name="ColLayout" Binding="{Binding Items}" Width="60" />
                    <DataGridTextColumn x:Name="ColNet" Binding="{Binding Net}" Width="90" />
                    <DataGridTextColumn x:Name="ColVat" Binding="{Binding Vat}" Width="80" />
                    <DataGridTextColumn x:Name="ColAmount" Binding="{Binding Amount}" Width="100" />
                    <DataGridTextColumn x:Name="ColPayment" Binding="{Binding Payment}" Width="120" />
                    <DataGridTextColumn x:Name="ColQr" Binding="{Binding Qr}" Width="50" />
                    <DataGridTextColumn x:Name="ColStatus" Binding="{Binding Status}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- stat chips -->
        <UniformGrid Grid.Row="3" Columns="4" Margin="0,12,0,0">
            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource hist.gross}" Style="{StaticResource CaptionText}" />
                    <TextBlock x:Name="LblGross" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource hist.taxTotal}" Style="{StaticResource CaptionText}" />
                    <TextBlock x:Name="LblTax" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarnBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource hist.netTotal}" Style="{StaticResource CaptionText}" />
                    <TextBlock x:Name="LblNet" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource hist.count}" Style="{StaticResource CaptionText}" />
                    <TextBlock x:Name="LblCount" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- breakdowns -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource hist.byCashier}" Style="{StaticResource H3Text}" Margin="2,0,0,8" />
                    <DataGrid x:Name="CashierGrid" Style="{StaticResource ModernGrid}" MaxHeight="210" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ColCashWho" Binding="{Binding Who}" Width="*" />
                            <DataGridTextColumn x:Name="ColCashSales" Binding="{Binding Sales}" Width="100" />
                            <DataGridTextColumn x:Name="ColCashCount" Binding="{Binding Count}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource hist.byTax}" Style="{StaticResource H3Text}" Margin="2,0,0,8" />
                    <DataGrid x:Name="TaxGrid" Style="{StaticResource ModernGrid}" MaxHeight="210" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ColTaxRate" Binding="{Binding Rate}" Width="80" />
                            <DataGridTextColumn x:Name="ColTaxGross" Binding="{Binding Gross}" Width="100" />
                            <DataGridTextColumn x:Name="ColTaxAmount" Binding="{Binding Tax}" Width="90" />
                            <DataGridTextColumn x:Name="ColTaxCount" Binding="{Binding Count}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource hist.byPayment}" Style="{StaticResource H3Text}" Margin="2,0,0,8" />
                    <DataGrid x:Name="PayGrid" Style="{StaticResource ModernGrid}" MaxHeight="210" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ColPayMethod" Binding="{Binding Method}" Width="*" />
                            <DataGridTextColumn x:Name="ColPaySales" Binding="{Binding Sales}" Width="100" />
                            <DataGridTextColumn x:Name="ColPayCount" Binding="{Binding Count}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="LblInfo" Grid.Row="5" Style="{StaticResource BodyText}" Margin="0,10,0,0" />
    </Grid>
</UserControl>