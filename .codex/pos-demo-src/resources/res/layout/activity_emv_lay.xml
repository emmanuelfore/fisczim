<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="32sp"
        android:textColor="@color/myellow"
        android:id="@+id/txtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="20dp"
        android:text="@string/emvTips"/>
    <TextView
        android:textSize="25sp"
        android:textColor="@color/colorPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="20dp"
        android:text="Result : "/>
    <TextView
        android:textSize="28sp"
        android:textColor="@color/colorAccent"
        android:gravity="center"
        android:id="@+id/tvEmvMsg"
        android:background="@drawable/shape_msg"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="20dp"
        android:text="..."/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="20dp">
        <Button
            android:textSize="28sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_emv"
            android:background="@drawable/shape_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:text="Emv Test"
            android:layout_weight="1"
            android:onClick="onClickTestEmv"/>
        <Button
            android:textSize="25sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_pinblock"
            android:background="@drawable/shape_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:text="pin Block"
            android:layout_weight="1"
            android:onClick="onClickPinBlock"/>
        <Button
            android:textSize="28sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:background="@drawable/shape_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Show Pad"
            android:layout_weight="1"
            android:onClick="onClickShowPad"/>
    </LinearLayout>
    <Button
        android:textSize="28sp"
        android:textColor="@color/white"
        android:background="@color/black"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:text="Test Emv PK"
        android:onClick="onClickTestPK"/>
    <Button
        android:textSize="22sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:background="@drawable/shape_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="appType"
        android:onClick="onClickAppType"/>
</LinearLayout>
