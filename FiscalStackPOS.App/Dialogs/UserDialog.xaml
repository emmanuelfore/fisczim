<Window x:Class="FiscalStackPOS.Dialogs.UserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ud.title}" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI" ShowInTaskbar="False">
    <Border Style="{StaticResource Card}" Margin="20">
        <StackPanel>
            <TextBlock Text="{DynamicResource ud.title}" Style="{StaticResource H1Text}" />
            <TextBlock Text="{DynamicResource ud.desc}"
                       Style="{StaticResource BodyText}" Margin="0,4,0,12" TextWrapping="Wrap" />

            <TextBlock Text="{DynamicResource ud.username}" Style="{StaticResource CaptionText}" />
            <TextBox x:Name="TxtUsername" Style="{StaticResource FieldTextBox}" />
            <TextBlock Text="{DynamicResource ud.full}" Style="{StaticResource CaptionText}" Margin="0,12,0,4" />
            <TextBox x:Name="TxtFull" Style="{StaticResource FieldTextBox}" />
            <TextBlock Text="{DynamicResource ud.password}" Style="{StaticResource CaptionText}" Margin="0,12,0,4" />
            <PasswordBox x:Name="TxtPass" Style="{StaticResource FieldPasswordBox}" />
            <TextBlock Text="{DynamicResource ud.pass2}" Style="{StaticResource CaptionText}" Margin="0,12,0,4" />
            <PasswordBox x:Name="TxtPass2" Style="{StaticResource FieldPasswordBox}" />
            <TextBlock Text="{DynamicResource ud.access}" Style="{StaticResource CaptionText}" Margin="0,12,0,4" />
            <ComboBox x:Name="CmbAccess" Style="{StaticResource FieldComboBox}" HorizontalAlignment="Left" Width="220" />

            <TextBlock x:Name="LblError" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="{DynamicResource common.cancel}" Style="{StaticResource GhostButton}" IsCancel="True" MinWidth="88" />
                <Button Content="{DynamicResource common.save}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" MinWidth="100"
                        Click="OnSave" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>