router.post("/statutory-settings", requirePayrollWrite, async (req, res) => {
  const companyId = getTargetCompanyId(req);
  try {
    const existing = await db.select().from(statutorySettings).where(eq(statutorySettings.companyId, companyId)).limit(1);
    let settings;
    if (existing.length > 0) {
      [settings] = await db.update(statutorySettings).set(req.body).where(eq(statutorySettings.companyId, companyId)).returning();
    } else {
      [settings] = await db.insert(statutorySettings).values({ ...req.body, companyId }).returning();
    }
    await auditPayroll(req, "PAYROLL_CONFIG_UPDATED", "statutory_settings", settings.id, { companyId });
    res.json(settings);
  } catch (err: any) {
    res.status(500).json({ error: "INTERNAL_ERROR", message: err.message });
  }
});

