<Window x:Class="FiscalStackPOS.Dialogs.CheckoutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource chk.title}" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI"
        ShowInTaskbar="False">
    <Border Style="{StaticResource Card}" Margin="22" Padding="18">
        <DockPanel LastChildFill="True">
            <!-- bottom actions -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                <TextBlock x:Name="LblStatus" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"
                           TextWrapping="Wrap" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="ChkPrint" Content="{DynamicResource chk.print}" IsChecked="True"
                                  Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <CheckBox x:Name="ChkCredit" Content="{DynamicResource chk.creditNote}" Margin="16,0,0,0"
                                  Foreground="{StaticResource TextSecondaryBrush}" Checked="OnCreditToggle" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="{DynamicResource chk.fiscalize}" Style="{StaticResource PrimaryButton}"
                            FontSize="15" Height="50" MinWidth="170" Click="OnFiscalize" x:Name="BtnFisc" />
                    <Button x:Name="BtnOk" Grid.Column="2" Content="{DynamicResource chk.done}" Style="{StaticResource PrimaryButton}"
                            FontSize="15" Height="50" MinWidth="130" Click="OnDone" IsDefault="True" Visibility="Collapsed" />
                </Grid>
            </StackPanel>

            <!-- main content -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <!-- left: order + customer + split -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,18,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource pos.currentOrder}" Style="{StaticResource CaptionText}" />
                        <TextBlock x:Name="LblTotal" Style="{StaticResource H1Text}" FontSize="22" Margin="0,4,0,14" />

                        <!-- items -->
                        <Border Background="{StaticResource BorderLightBrush}" CornerRadius="10" Padding="10" Margin="0,0,0,14">
                            <StackPanel x:Name="ItemsHost" />
                        </Border>

                        <!-- payment method -->
                        <TextBlock Text="{DynamicResource chk.payment}" Style="{StaticResource CaptionText}" Margin="0,4,0,8" />
                        <WrapPanel x:Name="MethodsHost" />

                        <TextBlock Text="{DynamicResource chk.paid}" Style="{StaticResource CaptionText}" Margin="0,14,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtPaid" Style="{StaticResource FieldTextBox}" FontSize="16" FontWeight="SemiBold" />
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock Text="{DynamicResource chk.change}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
                                <TextBlock x:Name="LblChange" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>

                        <!-- customer -->
                        <TextBlock Text="{DynamicResource chk.buyer}" Style="{StaticResource CaptionText}" Margin="0,18,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0"><TextBlock Text="{DynamicResource chk.name}" Style="{StaticResource CaptionText}" /><TextBox x:Name="TxtCust" Style="{StaticResource FieldTextBox}" /></StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2"><TextBlock Text="{DynamicResource chk.tin}" Style="{StaticResource CaptionText}" /><TextBox x:Name="TxtTin" Style="{StaticResource FieldTextBox}" /></StackPanel>
                            <StackPanel Grid.Row="1"><TextBlock Text="{DynamicResource chk.phone}" Style="{StaticResource CaptionText}" /><TextBox x:Name="TxtPhone" Style="{StaticResource FieldTextBox}" /></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="{DynamicResource chk.vatNo}" Style="{StaticResource CaptionText}" /><TextBox x:Name="TxtCustVat" Style="{StaticResource FieldTextBox}" /></StackPanel>
                            <StackPanel Grid.Row="2"><TextBlock Text="{DynamicResource chk.address}" Style="{StaticResource CaptionText}" /><TextBox x:Name="TxtAddr" Style="{StaticResource FieldTextBox}" /></StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="{DynamicResource chk.email}" Style="{StaticResource CaptionText}" /><TextBox x:Name="TxtEmail" Style="{StaticResource FieldTextBox}" /></StackPanel>
                        </Grid>

                        <!-- credit note fields (collapsed by default) -->
                        <StackPanel x:Name="CreditFields" Visibility="Collapsed" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="{DynamicResource chk.originalInv}" Style="{StaticResource CaptionText}" /><TextBox x:Name="TxtOrigInv" Style="{StaticResource FieldTextBox}" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource chk.comment}" Style="{StaticResource CaptionText}" /><TextBox x:Name="TxtComment" Style="{StaticResource FieldTextBox}" /></StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- right: QR + result summary -->
                <Grid Grid.Column="1">
                    <Border x:Name="ResultCard" Background="{StaticResource BorderLightBrush}" CornerRadius="12"
                            Padding="16" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="&#xE9BC;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                                       Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="LblResultInv" Style="{StaticResource H2Text}" FontSize="18"
                                       Foreground="{StaticResource SuccessBrush}" Margin="0,8,0,4" />
                            <TextBlock x:Name="LblResultInfo" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                            <Image x:Name="ImgQr" MaxWidth="220" Margin="0,14,0,0"
                                   HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="PendingCard" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.25">
                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                                   Foreground="{StaticResource TextSecondaryLightBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource chk.pending}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>