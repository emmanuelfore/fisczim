<UserControl x:Class="FiscalStackPOS.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource hist.title}" Style="{StaticResource H1Text}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="{DynamicResource hist.reprint}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OnReprint" />
                <Button Content="{DynamicResource hist.refund}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OnRefund" />
                <Button Content="{DynamicResource hist.submit}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OnSubmit" />
                <Button Content="{DynamicResource common.refresh}" Style="{StaticResource SecondaryButton}" Click="OnRefresh" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
            <DataGrid x:Name="Grid" Style="{StaticResource ModernGrid}" MouseDoubleClick="OnReprint">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="ColInvoice" Binding="{Binding Invoice}" Width="110" />
                    <DataGridTextColumn x:Name="ColTime" Binding="{Binding Time}" Width="170" />
                    <DataGridTextColumn x:Name="ColAmount" Binding="{Binding Amount}" Width="100" />
                    <DataGridTextColumn x:Name="ColPayment" Binding="{Binding Payment}" Width="120" />
                    <DataGridTextColumn x:Name="ColQr" Binding="{Binding Qr}" Width="60" />
                    <DataGridTextColumn x:Name="ColStatus" Binding="{Binding Status}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock x:Name="LblInfo" Grid.Row="2" Style="{StaticResource BodyText}" Margin="0,10,0,0" />
    </Grid>
</UserControl>