<Window x:Class="FiscalStackPOS.Dialogs.ReasonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource reason.title}" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI" ShowInTaskbar="False">
    <Border Style="{StaticResource Card}" Margin="20">
        <StackPanel>
            <TextBlock Text="{DynamicResource reason.title}" Style="{StaticResource H1Text}" />
            <TextBlock Text="{DynamicResource reason.choose}" Style="{StaticResource BodyText}"
                       Margin="0,4,0,12" TextWrapping="Wrap" />
            <ComboBox x:Name="CmbReason" Style="{StaticResource FieldComboBox}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="{DynamicResource common.cancel}" Style="{StaticResource GhostButton}" IsCancel="True" MinWidth="90" />
                <Button Content="{DynamicResource reason.confirm}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" MinWidth="90"
                        Click="OnVoid" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>