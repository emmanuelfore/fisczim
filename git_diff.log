+        eq(payrollRuns.companyId, companyId),
+        gte(payrollRuns.periodStart, periodStart),
+        lte(payrollRuns.periodStart, periodEnd)
+      )
+    });
+
+    let necEmployeeTotal = 0;
+    let necEmployerTotal = 0;
+
+    for (const run of runs) {
+      const lines = await db.select({ necEmployee: payrollRunEmployees.necEmployee, necEmployer: payrollRunEmployees.necEmployer })
+        .from(payrollRunEmployees)
+        .where(eq(payrollRunEmployees.payrollRunId, run.id));
+        
+      for (const line of lines) {
+        necEmployeeTotal += parseFloat(line.necEmployee || "0");
+        necEmployerTotal += parseFloat(line.necEmployer || "0");
+      }
+    }
+
+    res.json({
+      month,
+      necEmployeeTotal: necEmployeeTotal.toFixed(2),
+      necEmployerTotal: necEmployerTotal.toFixed(2),
+      totalDue: (necEmployeeTotal + necEmployerTotal).toFixed(2),
+    });
+
+  } catch (err: any) {
+    res.status(500).json({ error: "INTERNAL_ERROR", message: err.message });
+  }
+});
