+  async reverseJournalEntry(companyId: number, journalEntryId: number, userId: string, reversalDate: Date, reason: string): Promise<JournalEntry> {
+    return await db.transaction(async (tx) => {
+      // 1. Fetch original journal entry
+      const [original] = await tx.select().from(journalEntries)
+        .where(and(eq(journalEntries.id, journalEntryId), eq(journalEntries.companyId, companyId)));
+      
+      if (!original) throw new Error("Journal entry not found");
+      if (original.status === "REVERSED") throw new Error("Journal entry is already reversed");
+      
+      // 2. Prevent duplicate reversals
+      const [existingReversal] = await tx.select().from(journalEntries)
+        .where(eq(journalEntries.reversalOfJournalEntryId, journalEntryId));
+      if (existingReversal) {
+        throw new Error(`Journal entry has already been reversed by entry ${existingReversal.id}`);
+      }
+      
+      // 3. Period closure checks
+      await this.checkPeriodStatus(companyId, reversalDate, "GL", tx);
+
+      // 4. Fetch original ledger lines
+      const lines = await tx.select().from(ledgerEntries)
+        .where(eq(ledgerEntries.journalEntryId, journalEntryId));
+        
+      if (lines.length === 0) throw new Error("Journal entry has no lines to reverse");
+
+      // 5. Create new reversal journal entry
+      const [reversalJournal] = await tx.insert(journalEntries).values({
+        companyId,
+        branchId: original.branchId,
+        entryDate: reversalDate,
+        description: `Reversal of Journal Entry #${journalEntryId}: ${reason}`,
+        referenceType: "REVERSAL",
+        referenceId: String(journalEntryId),
+        journalType: original.journalType,
+        createdBy: userId,
+        status: "POSTED",
+        reversalOfJournalEntryId: journalEntryId
+      }).returning();
+
+      // 6. Insert inverted ledger lines
+      const invertedLines = lines.map(line => ({
+        companyId,
+        branchId: line.branchId,
+        accountId: line.accountId,
+        journalEntryId: reversalJournal.id,
+        entryDate: reversalDate,
+        type: line.type === "DEBIT" ? "CREDIT" : "DEBIT", // Invert the side
+        amount: line.amount, // Keep amount positive but opposite side
+        baseAmount: line.baseAmount,
+        currency: line.currency,
+        exchangeRate: line.exchangeRate,
+        memo: `Reversal of line ${line.id}`,
+        createdBy: userId
+      }));
+
+      await tx.insert(ledgerEntries).values(invertedLines);
+
+      // 7. Mark original as REVERSED
+      await tx.update(journalEntries).set({ status: "REVERSED" }).where(eq(journalEntries.id, journalEntryId));
+
+      // 8. Audit trail
+      await tx.insert(auditLogs).values({
+        companyId,
+        userId: userId || null,
+        action: "REVERSE_JOURNAL",
+        entityType: "JOURNAL_ENTRY",
+        entityId: String(journalEntryId),
+        details: { 
+          reason, 
+          reversalJournalId: reversalJournal.id,
+          reversalDate
+        }
+      });
+
+      return reversalJournal;
+    });
+  }
