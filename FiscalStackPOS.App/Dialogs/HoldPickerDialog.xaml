<Window x:Class="FiscalStackPOS.Dialogs.HoldPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource hold.title}" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI" ShowInTaskbar="False">
    <Border Style="{StaticResource Card}" Margin="20">
        <StackPanel>
            <TextBlock Text="{DynamicResource hold.title}" Style="{StaticResource H1Text}" />
            <TextBlock Text="{DynamicResource pos.currentOrder}" Style="{StaticResource BodyText}"
                       Margin="0,4,0,12" />
            <ListBox x:Name="ListHolds" Height="180" FontSize="13" HorizontalContentAlignment="Stretch" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="{DynamicResource common.exit}" Style="{StaticResource GhostButton}" IsCancel="True" MinWidth="80" />
                <Button Content="{DynamicResource hold.resume}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" MinWidth="100"
                        Click="OnResume" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>