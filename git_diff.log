+router.post("/tax-tables", requirePayrollWrite, async (req, res) => {
+  const companyId = getTargetCompanyId(req);
+  const schema = z.object({
+    name: z.string(),
+    currency: z.string(),
+    taxYear: z.number().int(),
+    effectiveFrom: z.string(),
+    isActive: z.boolean().default(true),
+    brackets: z.array(z.object({
+      minAmount: z.coerce.string(),
+      maxAmount: z.coerce.string().nullable().optional(),
+      rate: z.coerce.string(),
+      deductionConstant: z.coerce.string().default("0"),
+    }))
+  });
+
+  const parsed = schema.safeParse(req.body);
+  if (!parsed.success) return res.status(400).json({ error: "VALIDATION_ERROR", details: parsed.error.errors });
+
+  try {
+    await db.transaction(async (tx) => {
+      // Create tax table
+      const [table] = await tx.insert(taxTables).values({
+        companyId,
+        name: parsed.data.name,
+        currency: parsed.data.currency,
+        taxYear: parsed.data.taxYear,
+        effectiveFrom: parsed.data.effectiveFrom,
+        isActive: parsed.data.isActive,
+      }).returning();
+
+      // Create brackets
+      if (parsed.data.brackets.length > 0) {
+        await tx.insert(taxBrackets).values(
+          parsed.data.brackets.map(b => ({
+            taxTableId: table.id,
+            minAmount: b.minAmount,
+            maxAmount: b.maxAmount || null,
+            rate: b.rate,
+            deductionConstant: b.deductionConstant,
+          }))
+        );
+      }
+    });
+    res.json({ success: true });
+  } catch (err: any) {
+    res.status(500).json({ error: "INTERNAL_ERROR", message: err.message });
+  }
+});
+
+router.post("/tax-tables/seed", requirePayrollWrite, async (req, res) => {
+  const companyId = getTargetCompanyId(req);
+  const year = req.body.year || new Date().getFullYear();
+  try {
+    // Basic standard ZiG and USD tables for Zimbabwe
+    await db.transaction(async (tx) => {
+      // ZIG Table
+      const [zigTable] = await tx.insert(taxTables).values({
+        companyId, name: `ZIMRA ZiG Tax Tables ${year}`, currency: "ZiG", taxYear: year, effectiveFrom: `${year}-01-01`
+      }).returning();
+      await tx.insert(taxBrackets).values([
+        { taxTableId: zigTable.id, minAmount: "0", maxAmount: "1250000", rate: "0", deductionConstant: "0" },
+        { taxTableId: zigTable.id, minAmount: "1250001", maxAmount: "4000000", rate: "0.20", deductionConstant: "250000" },
