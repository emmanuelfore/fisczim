+    earning: payrollEarningTypes,
+    deduction: payrollDeductionTypes
+  })
+    .from(employeePayrollElements)
+    .leftJoin(payrollEarningTypes, eq(employeePayrollElements.earningTypeId, payrollEarningTypes.id))
+    .leftJoin(payrollDeductionTypes, eq(employeePayrollElements.deductionTypeId, payrollDeductionTypes.id))
     .where(and(
