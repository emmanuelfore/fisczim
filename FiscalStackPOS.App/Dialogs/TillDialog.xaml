<Window x:Class="FiscalStackPOS.Dialogs.TillDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource till.title}"
        Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI"
        ShowInTaskbar="False">
    <Border Style="{StaticResource Card}" Margin="24">
        <StackPanel>
            <TextBlock Text="{DynamicResource till.title}" Style="{StaticResource H1Text}" />
            <TextBlock Text="{DynamicResource till.desc}"
                       Style="{StaticResource BodyText}" Margin="0,6,0,16" TextWrapping="Wrap" />

            <TextBlock x:Name="LblCur" Text="{DynamicResource till.cash}" Style="{StaticResource CaptionText}" Margin="0,8,0,4" />
            <TextBox x:Name="TxtCash" Style="{StaticResource FieldTextBox}" Text="0.00" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="LblError" Foreground="{StaticResource DangerBrush}" FontSize="12"
                       Margin="0,8,0,0" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="{DynamicResource common.cancel}" Style="{StaticResource GhostButton}" IsCancel="True" MinWidth="76"
                        Click="OnSkip" />
                <Button Content="{DynamicResource till.open}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" MinWidth="110"
                        Click="OnOpen" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>