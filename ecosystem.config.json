{
    "apps": [
        {
            "name": "fiscalzone",
            "script": "./dist/index.cjs",
            "instances": 1,
            "exec_mode": "fork",
            "node_args": "--unhandled-rejections=throw",
            "env": {
                "NODE_ENV": "production",
                "PORT": 5001
            },
            "error_file": "./logs/pm2-error.log",
            "out_file": "./logs/pm2-out.log",
            "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
            "merge_logs": true,
            "autorestart": false,
            "max_restarts": 1,
            "min_uptime": "40s",
            "watch": false
        }
    ]
}