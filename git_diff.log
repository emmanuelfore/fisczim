+        emp.email || "",
+        emp.phone || "",
+        emp.status,
+        emp.department?.name || "",
+        emp.position?.title || "",
+        contract?.baseSalary || "0",
+        contract?.currency || "USD",
+        contract?.usdPercentage || "100",
+        contract?.zigPercentage || "0",
+        emp.bankName || "",
+        emp.bankAccountNumber || "",
+        emp.ecocashNumber || ""
+      ].map(v => `"${String(v).replace(/"/g, '""')}"`).join(",");
