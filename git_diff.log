+      eq(employeePayrollElements.employeeId, employeeId),
+      eq(employeePayrollElements.isActive, true),
+      sql`${employeePayrollElements.startDate} <= ${periodEnd}`,
+      sql`(${employeePayrollElements.endDate} IS NULL OR ${employeePayrollElements.endDate} >= ${periodStart})`
     ));
+
+  return elements.map((e: any) => {
+    if (e.earning) {
+      return {
+        type: "EARNING",
+        categoryId: e.earning.id,
+        name: e.earning.name,
+        calculationMethod: e.earning.calculationMethod,
+        percentageRate: Number(e.earning.taxablePercentage || 100) / 100, // example
+        amount: e.overrideAmount ? Number(e.overrideAmount) : (e.earning.calculationMethod === "FIXED" ? 0 : 0),
+        isTaxable: e.earning.taxTreatment === "TAXABLE",
+        isTaxDeductible: false
+      };
+    } else if (e.deduction) {
+      return {
+        type: "DEDUCTION",
+        categoryId: e.deduction.id,
+        name: e.deduction.name,
+        calculationMethod: e.deduction.calculationMethod,
+        percentageRate: Number(e.deduction.employeeRate || 0),
+        amount: e.overrideAmount ? Number(e.overrideAmount) : 0,
+        isTaxable: false,
+        isTaxDeductible: e.deduction.timing === "PRE_TAX" || e.deduction.category === "PENSION"
+      };
+    }
+    return null;
+  }).filter(Boolean);
 }
 
