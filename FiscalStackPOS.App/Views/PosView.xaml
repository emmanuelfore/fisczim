<UserControl x:Class="FiscalStackPOS.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="{StaticResource BgBrush}" FontFamily="Segoe UI"
             KeyDown="OnKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{StaticResource CartPanelWidth}" />
        </Grid.ColumnDefinitions>

        <!-- ==================== left: catalog ==================== -->
        <Grid Grid.Column="0" Margin="20,18,14,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- search + qty -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1.6*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                   Foreground="{StaticResource TextSecondaryLightBrush}" VerticalAlignment="Center"
                                   Margin="4,0,8,0" />
                        <TextBox x:Name="TxtSearch" Grid.Column="1" Style="{StaticResource FieldTextBox}"
                                 FontSize="14" KeyDown="OnSearchKeyDown" TextChanged="OnSearchChanged" />
                    </Grid>
                    <Grid Grid.Column="1" Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="58" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource pos.qty}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="TxtQty" Grid.Column="1" Style="{StaticResource FieldTextBox}" Text="1"
                                 TextAlignment="Center" FontWeight="SemiBold" />
                    </Grid>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource pos.holdF9}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                                Click="OnHold" />
                        <Button Content="{DynamicResource pos.resume}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                                Click="OnResume" />
                        <Button Content="{DynamicResource pos.freeItem}" Style="{StaticResource GhostButton}" Click="OnFreeItem" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- category pills -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden"
                          Margin="0,0,0,10">
                <StackPanel x:Name="CatHost" Orientation="Horizontal" />
            </ScrollViewer>

            <!-- product tiles -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="TileList" ItemsPanel="{StaticResource TilePanel}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ProductTile}" Width="132" Height="122" Margin="3"
                                    Content="{Binding}" Click="OnTileClick" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ==================== right: cart panel ==================== -->
        <Grid Grid.Column="1" Margin="0,18,20,18">
            <Border Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource pos.currentOrder}" Style="{StaticResource CaptionText}" />
                            <TextBlock x:Name="LblInvoice" Style="{StaticResource H2Text}" FontSize="16"
                                       Foreground="{StaticResource PrimaryDarkBrush}" Text="INV000001" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                Style="{StaticResource GhostButton}" ToolTip="{DynamicResource pos.clearCart}" Click="OnClearCart" />
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12" />

                    <!-- cart lines -->
                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="CartList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"
                                                       TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                                    <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                            FontSize="12" Style="{StaticResource GhostButton}"
                                                            Foreground="{StaticResource TextSecondaryLightBrush}"
                                                            Padding="6" ToolTip="{DynamicResource pos.lineVoid}" Click="OnVoidLine" />
                                                </Grid>
                                                <Grid Grid.Row="1" Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Content="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                            Style="{StaticResource GhostButton}" Padding="7,3"
                                                            VerticalAlignment="Center" Click="OnMinus" />
                                                    <Border Grid.Column="1" MinWidth="44" Margin="6,0" CornerRadius="6"
                                                            Background="{StaticResource BorderLightBrush}" Padding="0,3"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding QuantityLabel}" HorizontalAlignment="Center"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextBrush}" />
                                                    </Border>
                                                    <Button Grid.Column="2" Content="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                                            FontSize="11" Style="{StaticResource GhostButton}" Padding="7,3"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                                            Click="OnPlus" ToolTip="{DynamicResource pos.increaseQty}" />
                                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding LineTotalLabel}" FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                                                   HorizontalAlignment="Right" />
                                                        <TextBlock Text="{Binding UnitLabel}" FontSize="9.5"
                                                           Foreground="{StaticResource TextSecondaryLightBrush}"
                                                           HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="LblEmpty" Text="{DynamicResource pos.emptyCart}"
                                   Style="{StaticResource BodyText}" TextWrapping="Wrap" LineHeight="18"
                                   VerticalAlignment="Top" />
                    </Grid>

                    <!-- totals -->
                    <Border Grid.Row="2" Background="{StaticResource BorderLightBrush}" CornerRadius="10" Padding="12,10" Margin="0,8,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{DynamicResource pos.subtotal}" Style="{StaticResource BodyText}" />
                                <TextBlock x:Name="LblSubtotal" HorizontalAlignment="Right" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <TextBlock Text="{DynamicResource pos.vat}" Style="{StaticResource BodyText}" />
                                <TextBlock x:Name="LblVat" HorizontalAlignment="Right" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <TextBlock Text="{DynamicResource pos.total}" Style="{StaticResource H2Text}" FontSize="16" />
                                <TextBlock x:Name="LblTotal" HorizontalAlignment="Right" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryDarkBrush}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- actions -->
                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <Button x:Name="BtnPay" Content="{DynamicResource pos.payF10}" Style="{StaticResource PrimaryButton}"
                                Height="54" FontSize="15" Click="OnPay" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>