      .where(and(eq(payslipDocuments.companyId, companyId), eq(payslipDocuments.payrollRunId, runId)))
      .orderBy(desc(payslipDocuments.generatedAt));
    res.json(docs);
  } catch (err: any) {
    res.status(500).json({ error: "INTERNAL_ERROR", message: err.message });
  }
